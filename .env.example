# Copy this file to ".env" and fill in the two values from Supabase:
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Use the "anon public" key ONLY. NEVER put the service_role key in this app.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Leave both blank to run fully offline with the bundled JSON (progress saved in this browser).
